# Copy to .env.local for local overrides. Never commit real values.

# Server-only (no NEXT_PUBLIC_ prefix, so it is never sent to the browser).
# Base URL of rocky-api, used by the /api rewrite and by server-side code that
# calls the API directly. Use 127.0.0.1, not localhost: the API binds to IPv4 only.
# Default: http://127.0.0.1:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Server-only. Required. The Firebase Storage bucket name (no gs:// prefix, no path),
# as used by rocky-api. next/image only loads media from this bucket.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
