# Copy to .env.local for local overrides. Never commit real values.
# On the EC2 server, create .env.local in the repository root as well.
#
# When these are read: BOTH at build time and at runtime, so they must be set, with the
# same values, for `npm run build` and for `next start` (PM2).
# - Build: `next build` evaluates next.config.ts, and the results are baked into the
#   build output (the /api rewrite in routes-manifest.json, the image bucket in
#   images-manifest.json). Changing a value therefore needs a rebuild.
# - Runtime: `next start` loads next.config.ts again and validates these variables
#   (src/lib/server-env-schema.ts), so a missing value stops the server at startup.
# deploy/redeploy.sh always rebuilds and then reloads, so editing this file and running
# it is enough.
#
# Neither variable has the NEXT_PUBLIC_ prefix, so neither is inlined into the browser
# bundle.

# Server-only (no NEXT_PUBLIC_ prefix, so it is never sent to the browser).
# Base URL of rocky-api, used by the /api rewrite and by server-side code that
# calls the API directly. Use 127.0.0.1, not localhost: the API binds to IPv4 only.
# In production Nginx routes /api to the API before requests reach Next.js, so the
# rewrite is only a fallback there; the default matches the EC2 setup.
# Default: http://127.0.0.1:4000
API_INTERNAL_URL=http://127.0.0.1:4000

# Server-only. Required. The Firebase Storage bucket name (no gs:// prefix, no path),
# as used by rocky-api. next/image only loads media from this bucket.
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
